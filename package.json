{
	"name": "taskt",
	"description": "A local first Task management application focused on user experience",
	"version": "0.0.1",
	"scripts": {
		"start": "expo start --android",
		"build": "expo run:android",
		"clean": "expo start -c --android",
		"upgrade": "bunx expo install --check",
		"doctor": "bunx expo-doctor",
		"lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
		"format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"prebuild": "expo prebuild --clean --platform android",
		"local": "cd android && ./gradlew assembleRelease",
		"phone": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
		"genymotion": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=x86_64",
		"debug": "cd android && ./gradlew :app:assembleDebug -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64"
	},
	"type": "module",
	"dependencies": {
		"@expo/vector-icons": "^15.0.3",
		"@js-temporal/polyfill": "^0.5.1",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@tailwindcss/postcss": "^4.3.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"expo": "~58.0.14",
		"expo-constants": "~58.0.12",
		"expo-font": "~58.0.8",
		"expo-intent-launcher": "~58.0.3",
		"expo-linking": "~58.0.13",
		"expo-notifications": "~58.1.5",
		"expo-router": "~58.0.23",
		"expo-splash-screen": "~58.0.10",
		"expo-sqlite": "~58.0.13",
		"expo-status-bar": "~58.0.3",
		"expo-system-ui": "~58.0.6",
		"nativewind": "^5.0.0-preview.4",
		"postcss": "^8.5.15",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-css": "^3.0.7",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-get-random-values": "~1.11.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.13.0",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@types/react": "~19.3.0",
		"babel-plugin-inline-import": "^3.0.0",
		"babel-preset-expo": "~58.0.0",
		"drizzle-kit": "^1.0.0-rc.4",
		"eslint": "^9.25.1",
		"eslint-config-expo": "~58.0.4",
		"eslint-config-prettier": "^10.1.2",
		"prettier": "^3.2.5",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3"
	},
	"main": "expo-router/entry",
	"private": true,
	"overrides": {
		"lightningcss": "1.30.1"
	}
}
