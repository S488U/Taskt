{
	"name": "taskt",
	"description": "A local first Task management application focused on user experience",
	"version": "0.0.1",
	"scripts": {
		"start": "expo start --android",
		"build": "expo run:android",
		"clean": "expo start -c --android",
		"upgrade": "bunx expo install --check",
		"doctor": "bunx expo-doctor",
		"lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
		"format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"local": "cd android && ./gradlew assembleRelease",
		"phone": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
		"genymotion": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=x86_64"
	},
	"type": "module",
	"dependencies": {
		"@expo/vector-icons": "^15.0.3",
		"@js-temporal/polyfill": "^0.5.1",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/datetimepicker": "8.6.0",
		"@tailwindcss/postcss": "^4.3.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"expo": "~55.0.31",
		"expo-constants": "~55.0.17",
		"expo-font": "~55.0.8",
		"expo-linking": "~55.0.17",
		"expo-router": "~55.0.18",
		"expo-sqlite": "~55.0.20",
		"expo-status-bar": "~55.0.6",
		"expo-system-ui": "~55.0.22",
		"nativewind": "^5.0.0-preview.4",
		"postcss": "^8.5.15",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-native": "0.83.10",
		"react-native-css": "^3.0.7",
		"react-native-gesture-handler": "~2.30.0",
		"react-native-get-random-values": "~1.11.0",
		"react-native-reanimated": "4.2.1",
		"react-native-safe-area-context": "~5.6.2",
		"react-native-screens": "~4.23.0",
		"react-native-svg": "15.15.3",
		"react-native-worklets": "0.7.4",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@types/react": "~19.2.10",
		"babel-plugin-inline-import": "^3.0.0",
		"babel-preset-expo": "^55.0.25",
		"drizzle-kit": "^1.0.0-rc.4",
		"eslint": "^9.25.1",
		"eslint-config-expo": "~55.0.1",
		"eslint-config-prettier": "^10.1.2",
		"prettier": "^3.2.5",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~5.9.2"
	},
	"main": "expo-router/entry",
	"private": true,
	"overrides": {
		"lightningcss": "1.30.1"
	}
}
